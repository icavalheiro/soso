<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="LiteDB" Version="5.0.21" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
        <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" Condition="$(RuntimeIdentifier.EndsWith('-x64'))" />
        <PackageReference Include="Magick.NET-Q8-arm64" Version="14.17.2" Condition="$(RuntimeIdentifier.EndsWith('-arm64'))" />
    </ItemGroup>
</Project>
